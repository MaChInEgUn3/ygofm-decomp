# Copyrighted game assets — never commit these. Everyone who works on this
# repo must dump their own legally-owned copy of the disc.
YUGIOH.*
*.bin
*.cue
*.iso
*.ccd
*.img
*.sub
/extracted/

# Third-party decomp trees shared for comparison (Unchiga's ygofm-decomp.zip and
# anything unpacked from it). Someone else's work and someone else's history --
# never commit it here, and note that these archives carry their own copies of
# the retail binary and extracted disc data.
/ygofm-decomp.zip
/*.zip
/third_party/

# Downloaded third-party binaries (Ghidra + plugin, PsyQ SDK) — not ours to redistribute.
/tools/

# Python virtualenv for decomp tooling (splat, asm-differ) — regenerable, not portable across machines.
/.venv/

# splat build output (re-derivable from extracted/ + config/ any time).
/build/

# Huge (~26MB), mostly-zero raw data dump of the still-uninvestigated trailing region (see docs/DECISIONS.md).
# Regenerate with splat once needed; not worth bloating repo history until we know what's actually in there.
/asm/data/carddata.data.s

# Ghidra project database (binary, machine-specific, regenerable from extracted/ + tools_src/).
/ghidra_project/*.gpr
/ghidra_project/*.rep/
/ghidra_project/scripts/
/ghidra_project/*.txt
/ghidra_project/import_log*.txt
/ghidra_project/inventory_log.txt
/ghidra_project/dump_log*.txt

# Browser automation scratch (Playwright MCP).
/.playwright-mcp/

# OS/editor cruft
Thumbs.db
.DS_Store

# Claude Code session/harness artifacts — not project content.
/.claude/

# Reproducible from `python tools_src/build.py`.
/build/

# splat regenerates this monolithic INCLUDE_ASM file, but the build uses
# per-function src/func_*.c instead and ignores it. See docs/DECISIONS.md.
/src/31D8.c

# Scratch file for per-function flag experiments (see build.py).
/config/flag_overrides.json

# Local assistant entry point; the content it points at is docs/WORKFLOW.md,
# which is versioned. Keeping this out of the repo so the project's docs stand
# on their own.
/CLAUDE.md

__pycache__/
*.pyc
ct[abe][0-9]*

# Working drafts of messages to other people. Never tracked: they are
# notes-to-self about a conversation, not documentation of the binary.
docs/DRAFT_*.md

# Third-party reverse-engineering output shared privately (krystalgamer,
# 2026-08-31): Hex-Rays C for this binary and for Duelist of the Roses.
# Not ours to publish, and not derived from our own disassembly.
gms.c
dotr.c

# Unchiga naming corpus, shared 2026-08-31 while he prepares a PR of his own.
# NOT ignored because it is unwanted -- ignored so an `add -A` here cannot land
# his work under our authorship. It should arrive as his commits.
symbols_guide.md
known_functions.md
known_variables.md
findings.md
suspects.md
descriptions.md
fm-field-guide.html
naming_crosscheck.md
